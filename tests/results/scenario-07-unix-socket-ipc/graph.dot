    legend [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#bbdefb">Action #1: setup project and install depe</TD></TR><TR><TD BGCOLOR="#c8e6c9">Action #2: build project</TD></TR><TR><TD BGCOLOR="#fff9c4">Action #3: run tests</TD></TR><TR><TD BGCOLOR="#ffccbc">Action #4: cleanup build artifacts</TD></TR></TABLE>>];
  }
}
